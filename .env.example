# At least 16 characters. Used for sign-in and signed sessions. Never use NEXT_PUBLIC_.
ADMIN_PASSWORD=
# Connect a PRIVATE Vercel Blob store and enable its read/write-token environment variable.
BLOB_READ_WRITE_TOKEN=
# Connect Upstash Redis through Vercel Marketplace or copy these from Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional; separate playlists when multiple projects share a database.
# STUDIO_NAMESPACE=cimp-partners
